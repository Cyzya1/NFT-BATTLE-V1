
name: Build NFT BATTLE APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'NFT_BATTLE_BIG_UPDATE_WORKING_V28_ORIGINAL_BG_FRAMES.zip'
      - '.github/workflows/android.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Gradle 8.9
        run: |
          curl -fL https://services.gradle.org/distributions/gradle-8.9-bin.zip -o /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /tmp
          echo "/tmp/gradle-8.9/bin" >> "$GITHUB_PATH"

      - name: Extract project ZIP
        run: |
          unzip -o NFT_BATTLE_BIG_UPDATE_WORKING_V28_ORIGINAL_BG_FRAMES.zip -d project
          find project -type f \( -name settings.gradle -o -name settings.gradle.kts \)

      - name: Locate Android project
        run: |
          FILE=$(find project -type f \( -name settings.gradle -o -name settings.gradle.kts \) | head -1)
          if [ -z "$FILE" ]; then
            echo "ERROR: No settings.gradle found in ZIP"
            exit 1
          fi
          ROOT="${FILE%/*}"
          echo "PROJECT_ROOT=$ROOT" >> "$GITHUB_ENV"
          echo "Android project: $ROOT"

      - name: Build debug APK
        run: |
          gradle -p "$PROJECT_ROOT" assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: NFT-BATTLE-APK
          path: project/**/build/outputs/apk/debug/*.apk
          if-no-files-found: error
